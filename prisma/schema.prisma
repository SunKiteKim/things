generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String?
  provider      String   @default("credentials")
  providerId    String?
  role          String   @default("MEMBER")
  zipCode       String?
  address       String?
  addressDetail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  updatedProducts Product[] @relation("ProductUpdatedBy")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  imageUrl    String    @default("")
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  products    Product[]
}

model Product {
  id                 String               @id
  name               String
  slug               String               @unique
  description        String               @default("")
  price              Int
  originalPrice      Int?
  discountRate       Int                  @default(0)
  stock              Int                  @default(10)
  imageUrl           String
  gallery            String               @default("[]")
  isPublished        Boolean              @default(true)
  isFeatured         Boolean              @default(false)
  sortOrder          Int                  @default(0)
  categoryId         String
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  registeredAt       DateTime             @default(now())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  updatedById        String?
  updatedByName      String               @default("")
  updatedBy          User?                @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  exhibitionProducts ExhibitionProduct[]
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String  @default("")
  imageUrl  String
  href      String  @default("/")
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model Exhibition {
  id          String               @id @default(cuid())
  title       String
  slug        String               @unique
  description String               @default("")
  imageUrl    String
  startAt     DateTime
  endAt       DateTime
  isActive    Boolean              @default(true)
  products    ExhibitionProduct[]
}

model ExhibitionProduct {
  exhibitionId String
  productId    String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([exhibitionId, productId])
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  discountType   String
  discountValue  Int
  minOrderAmount Int      @default(0)
  maxUses        Int?
  usedCount      Int      @default(0)
  startAt        DateTime
  endAt          DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  status         String      @default("PENDING")
  totalAmount    Int
  discountAmount Int         @default(0)
  paymentMethod  String      @default("TOSS")
  paymentKey     String?
  tossOrderId    String?
  receiverName   String
  receiverPhone  String
  zipCode        String
  address        String
  addressDetail  String      @default("")
  memo           String      @default("")
  couponCode     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Int
  quantity  Int
  imageUrl  String
}
