generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  phone               String?
  passwordHash        String?
  provider            String               @default("credentials")
  providerId          String?
  role                String               @default("MEMBER")
  zipCode             String?
  address             String?
  addressDetail       String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  recoveryCodes       AdminRecoveryCode[]
  memberRecoveryCodes MemberRecoveryCode[]
  orders              Order[]
  updatedProducts     Product[]            @relation("ProductUpdatedBy")
  couponIssues        CouponIssue[]
  wishlistItems       WishlistItem[]
}

model Category {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String        @default("")
  imageUrl     String        @default("")
  sortOrder    Int           @default(0)
  isVisible    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  products     Product[]
  couponIssues CouponIssue[]
}

model Product {
  id                 String              @id
  name               String
  slug               String              @unique
  description        String              @default("")
  price              Int
  originalPrice      Int?
  discountRate       Int                 @default(0)
  onePlusOne         Boolean             @default(false)
  stock              Int                 @default(10)
  imageUrl           String
  gallery            String              @default("[]")
  isPublished        Boolean             @default(true)
  isFeatured         Boolean             @default(false)
  sortOrder          Int                 @default(0)
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  registeredAt       DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  updatedById        String?
  updatedByName      String              @default("")
  updatedBy          User?               @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  orderItems         OrderItem[]
  exhibitionProducts ExhibitionProduct[]
  wishlistItems      WishlistItem[]
}

model Banner {
  id        String  @id @default(cuid())
  title     String
  subtitle  String  @default("")
  imageUrl  String
  href      String  @default("/")
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  endAt     DateTime?
}

model DisplayItem {
  id        String  @id @default(cuid())
  pageKey   String
  slotKey   String
  kind      String
  refId     String  @default("")
  label     String
  href      String  @default("")
  icon      String  @default("")
  sortOrder Int     @default(0)
  isVisible Boolean @default(true)

  @@unique([pageKey, slotKey])
  @@index([pageKey, sortOrder])
}

model Exhibition {
  id          String              @id @default(cuid())
  title       String
  slug        String              @unique
  description String              @default("")
  imageUrl    String
  startAt       DateTime
  endAt         DateTime
  isActive      Boolean             @default(true)
  discountType  String              @default("NONE")
  discountValue Int                 @default(0)
  products      ExhibitionProduct[]
}

model ExhibitionProduct {
  exhibitionId String
  productId    String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([exhibitionId, productId])
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  scope              String        @default("CART")
  includedProductIds String        @default("[]")
  excludedProductIds String        @default("[]")
  discountType       String
  discountValue      Int
  maxDiscountAmount  Int               @default(0)
  minOrderAmount     Int           @default(0)
  minQuantity        Int           @default(0)
  maxUses            Int?
  usedCount          Int           @default(0)
  startAt            DateTime
  endAt              DateTime
  isActive           Boolean       @default(true)
  isPaused           Boolean       @default(false)
  isStackable        Boolean       @default(false)
  createdAt          DateTime      @default(now())
  issues             CouponIssue[]
}

model CouponIssue {
  id         String    @id @default(cuid())
  couponId   String
  targetType String
  userId     String?
  categoryId String?
  createdAt  DateTime  @default(now())
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@unique([couponId, categoryId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique
  userId                String
  user                  User        @relation(fields: [userId], references: [id])
  status                String      @default("PENDING")
  totalAmount           Int
  discountAmount        Int         @default(0)
  paymentMethod         String      @default("TOSS")
  paymentKey            String?
  tossOrderId           String?
  receiverName          String
  receiverPhone         String
  zipCode               String
  address               String
  addressDetail         String      @default("")
  memo                  String      @default("")
  couponCode            String?
  trackingNumber        String?
  paidAt                DateTime?
  preparingAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  cancelledAt           DateTime?
  returnRequestedAt     DateTime?
  exchangeRequestedAt   DateTime?
  collectionConfirmedAt DateTime?
  returnedAt            DateTime?
  exchangedAt           DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  items                 OrderItem[]
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id])
  name         String
  price        Int
  quantity     Int
  freeQuantity Int     @default(0)
  imageUrl     String
}

model AdminRecoveryCode {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MemberRecoveryCode {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
