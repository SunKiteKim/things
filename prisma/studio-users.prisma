// Studio user browsing only. Never use this schema with db push or migrations.
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  phone         String?
  passwordHash  String?
  provider      String   @default("credentials")
  providerId    String?
  role          String   @default("MEMBER")
  zipCode       String?
  address       String?
  addressDetail String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
